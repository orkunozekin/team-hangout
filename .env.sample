# Copy to .env.local and fill in values:
#   cp .env.sample .env.local

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# EAS project ID used to request Expo push tokens in development/store builds.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Web OAuth client ID from Firebase / Google Cloud (used for Google Sign-In ID tokens)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# App Store legal / support URLs (omit or leave blank until hosted pages exist)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
