{
  "name": "team-hangout",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "^54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.17.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "firebase-tools": "15.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "test-renderer": "1.0.0",
    "tsx": "4.20.6",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "test:backend": "npm --prefix functions run build && node scripts/test-backend.mjs",
    "test:operations": "npm --prefix functions run build && node scripts/test-backend.mjs --operations",
    "test:contracts": "node --import tsx --test tests/backend/contracts.test.mjs",
    "test:admin": "yarn --cwd functions build && yarn --cwd admin build --mode emulator && node scripts/test-admin.mjs",
    "rehearse:phase1": "npm --prefix functions run build && node scripts/rehearsal/run.mjs",
    "test:scheduling": "npm --prefix functions run build && node --test tests/scheduling/*.test.mjs",
    "benchmark:scheduling": "npm --prefix functions run build && node scripts/benchmark-scheduling.mjs"
  }
}
