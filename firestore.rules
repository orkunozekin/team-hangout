rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid));
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberDocId(teamId) {
      return teamId + '_' + request.auth.uid;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.appRole == 'superAdmin';
    }

    function isTeamMember(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teamMembers/$(memberDocId(teamId)))
        && get(/databases/$(database)/documents/teamMembers/$(memberDocId(teamId))).data.teamId == teamId
        && get(/databases/$(database)/documents/teamMembers/$(memberDocId(teamId))).data.userId == request.auth.uid;
    }

    function isCoach(teamId) {
      return isTeamMember(teamId)
        && get(/databases/$(database)/documents/teamMembers/$(memberDocId(teamId))).data.role == 'coach';
    }

    function isLegacy(data) {
      return !('orgId' in data) && (!('schemaVersion' in data) || data.schemaVersion != 2);
    }

    function legacyTeam(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        && isLegacy(get(/databases/$(database)/documents/teams/$(teamId)).data);
    }

    function canManageTeam(teamId) {
      return isCoach(teamId) || isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'appRole', 'activeTeamId', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.appRole == 'user'
        && request.resource.data.activeTeamId == null
        && request.resource.data.displayName is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (
          isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'activeTeamId', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeTeamId'])
              || request.resource.data.activeTeamId == null
              || isTeamMember(request.resource.data.activeTeamId)
              || isSuperAdmin())
        ) || (
          isSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appRole', 'updatedAt'])
          && request.resource.data.appRole in ['user', 'superAdmin']
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if false;
    }

    match /teams/{teamId} {
      allow get: if isLegacy(resource.data) && (isTeamMember(teamId) || isSuperAdmin());
      allow list: if false;
      // Update Team Hangout: team writes now require authenticated callable commands.
      allow create, update, delete: if false;
    }

    match /inviteCodes/{code} {
      // Joining resolves the supplied code on the server without exposing lookup records.
      allow read, write: if false;
    }

    match /teamMembers/{memberId} {
      allow get: if signedIn()
        && (resource.data.userId == request.auth.uid
            || (legacyTeam(resource.data.teamId) && (isTeamMember(resource.data.teamId) || isSuperAdmin())));
      allow list: if signedIn()
        && (resource.data.userId == request.auth.uid
            || (legacyTeam(resource.data.teamId) && (isTeamMember(resource.data.teamId) || isSuperAdmin())));

      allow create, update: if false;
      allow delete: if isLegacy(resource.data) && legacyTeam(resource.data.teamId)
        && (isSelf(resource.data.userId) || canManageTeam(resource.data.teamId));
    }

    match /events/{eventId} {
      allow get: if isLegacy(resource.data) && legacyTeam(resource.data.teamId) && (isTeamMember(resource.data.teamId) || isSuperAdmin())
        && resource.data.deletedAt == null;
      allow list: if isLegacy(resource.data) && legacyTeam(resource.data.teamId) && (isTeamMember(resource.data.teamId) || isSuperAdmin())
        && resource.data.deletedAt == null;
      // Update Team Hangout: event writes now require revisioned callable commands.
      allow create, update, delete: if false;

      // Phase 3 private and derived records remain server-only until their owning step adds
      // a callable plus live scoped authorization. A platform role or parent event read is not access.
      match /coaching/{teamId}/{document=**} {
        allow read, write: if false;
      }
      match /lineupViews/{teamId}/{document=**} {
        allow read, write: if false;
      }
      match /playSessions/{teamId}/{document=**} {
        allow read, write: if false;
      }
      match /volunteerSlots/{slotId}/{document=**} {
        allow read, write: if false;
      }
      match /rideRequests/{requestId}/{document=**} {
        allow read, write: if false;
      }
      match /rideArrangements/{arrangementId}/{document=**} {
        allow read, write: if false;
      }
      match /practicePlans/{teamId}/{document=**} {
        allow read, write: if false;
      }
    }

    match /organizations/{orgId}/competitions/{competitionId}/{document=**} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/reportRuns/{runId}/{document=**} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/rolloverJobs/{jobId}/{document=**} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/practiceResources/{resourceId}/{document=**} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/rsvpReminders/{reminderId} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/conversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
        match /reactions/{reactionId} {
          allow read, write: if false;
        }
        match /edits/{editId} {
          allow read, write: if false;
        }
      }
    }
    match /organizations/{orgId}/messageSearch/{messageId} {
      allow read, write: if false;
    }
    match /platformConfig/{docId} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/attachments/{attachmentId} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/attachmentSlots/{slotId} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/staffNotes/{scopeKey} {
      allow read, write: if false;
      match /entries/{noteId} {
        allow read, write: if false;
      }
    }
    match /organizations/{orgId}/deliveryIssues/{issueId} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/criticalUpdates/{updateId} {
      allow read, write: if false;
    }
    match /rsvpReminderScans/{scanId} {
      allow read, write: if false;
    }
  }
}
